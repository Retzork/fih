# Godot 4+ specific ignores
.godot/
/android/

# REA snapshot cache (machine-local; regenerates on demand - durable results live in docs/evidence/)
docs/analysis/snapshots/

# Extracted game assets (personal use only, Q-0006; regenerate with tools/extract-assets.ps1)
assets_raw/

# Windowed verification captures (local eyeballing only; regenerated by tools/godot/screenshot.gd)
shot_*.png
shot_*.png.import

# Probe/review captures under docs/captures stay local too; only .gdignore is tracked so Godot
# skips the folder in a fresh checkout.
docs/captures/*
!docs/captures/.gdignore

# Ghidra headless stderr dumps (the durable extract beside them in docs/evidence/ is the record)
docs/evidence/*.err

# Ad-hoc scratch: crops, logs and one-off probe scripts (deleted once the reading is taken)
tmp_*
tmp_*.import

# Live player saves written by the game itself, not part of the tree
userdata/

# Art review artifacts (regenerable: tools/godot/export_review_assets.gd + tools/review/build_review.py)
docs/review/
.venv-review/

# Python caches from the review-art tooling
__pycache__/
*.pyc
